# =====================================================================
# SGP Serfamilia · Variables de entorno (copiar a .env y ajustar)
#   cp .env.example .env        (Linux/macOS/Git Bash)
#   copy .env.example .env      (Windows CMD)
# .env NO se versiona (ver .gitignore).
# =====================================================================

NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# --- PostgreSQL LOCAL ------------------------------------------------
# Usuario y base que crea scripts/setup-db.(ps1|sh). Cambie la clave si desea.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sgp
DB_PASSWORD=sgp_dev
DB_NAME=sgp
DB_SSL=false

# Solo para scripts/setup-db: credenciales de un superusuario local de Postgres
# (el que definió al instalar PostgreSQL). Se usan una sola vez para crear el rol y la BD.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=cambiar_por_su_clave_de_postgres

# --- JWT (ADR-004) ---------------------------------------------------
# Mínimo 32 caracteres. Genere valores propios:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-cambiar-por-un-valor-largo-y-aleatorio-0001
JWT_REFRESH_SECRET=dev-refresh-secret-cambiar-por-un-valor-largo-y-aleatorio-0002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Evidencias: MinIO (docker compose up -d) ------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sgp_minio
S3_SECRET_KEY=sgp_minio_secret
S3_BUCKET=evidencias
S3_FORCE_PATH_STYLE=true

# --- Correo: Mailpit en desarrollo (bandeja en http://localhost:8025) -
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SGP Serfamilia <no-reply@serfamilia.local>"
